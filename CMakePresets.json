{
    "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
    "version": 10,
    "configurePresets": [
        {
            "name": "default-no-tests",
            "displayName": "Enables all configurations without testing.",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release;MinSizeRel"
            }
        },
        {
            "name": "default",
            "displayName": "Enables all configurations and testing.",
            "inherits": "default-no-tests",
            "cacheVariables": {
                "BUILD_TESTS": "ON"
            }
        },
        {
            "name": "asan",
            "displayName": "AddressSanitizer + UndefinedBehaviorSanitizer (gcc only)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "OFF",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
                "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined",
                "CMAKE_MODULE_LINKER_FLAGS": "-fsanitize=address,undefined",
                "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
                "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "parallel",
            "hidden": true,
            "jobs": 0
        },
        {
            "name": "no-tests",
            "hidden": true,
            "inherits": "parallel",
            "configurePreset": "default-no-tests"
        },
        {
            "name": "debug-no-tests",
            "displayName": "Build default Debug",
            "inherits": "no-tests",
            "configuration": "Debug"
        },
        {
            "name": "release-no-tests",
            "displayName": "Build default Release",
            "inherits": "no-tests",
            "configuration": "Release"
        },
        {
            "name": "minsizerel-no-tests",
            "displayName": "Build default MinSizeRel",
            "inherits": "no-tests",
            "configuration": "MinSizeRel"
        },
        {
            "name": "default",
            "inherits": "no-tests",
            "configurePreset": "default"
        },
        {
            "name": "all",
            "displayName": "Build all targets and tests in Debug configuration",
            "inherits": "debug",
            "targets": ["all", "tests"]
        },
        {
            "name": "debug",
            "displayName": "Build default Debug",
            "inherits": "default",
            "configuration": "Debug"
        },
        {
            "name": "release",
            "displayName": "Build default Release",
            "inherits": "default",
            "configuration": "Release"
        },
        {
            "name": "minsizerel",
            "displayName": "Build default MinSizeRel",
            "inherits": "default",
            "configuration": "MinSizeRel"
        },
        {
            "name": "tests",
            "displayName": "Build tests",
            "inherits": "default",
            "configuration": "Debug",
            "targets": "tests"
        },
        {
            "name": "asan",
            "displayName": "AddressSanitizer + UndefinedBehaviorSanitizer with gcc",
            "inherits": "parallel",
            "configurePreset": "asan"
        }
    ],
    "testPresets": [
        {
            "name": "all",
            "displayName": "Run all tests",
            "configurePreset": "default",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 0
            }
        }
    ]
}